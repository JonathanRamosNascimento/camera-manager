post_install() {
    # Aplica a regra da NPU já, sem esperar o próximo boot.
    udevadm control --reload 2>/dev/null || true
    udevadm trigger --subsystem-match=accel --action=change 2>/dev/null || true

    # Há uma NPU mas o OpenVINO (que a usa) não está instalado: avisa uma vez.
    if ls /dev/accel/accel* >/dev/null 2>&1 && ! pacman -Q openvino-intel-npu-plugin >/dev/null 2>&1; then
        echo ':: Este computador tem uma NPU. Para usá-la na identificação de objetos:'
        echo '     sudo pacman -S openvino openvino-intel-npu-plugin'
        echo '   Sem isso o app funciona normalmente, na CPU.'
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    udevadm control --reload 2>/dev/null || true
}
